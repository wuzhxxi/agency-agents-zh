{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-agents-zh.local/search-growth/backlog-item.schema.json",
  "title": "BacklogItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "priority",
    "initiative",
    "owner",
    "dependencies",
    "aeo_impact",
    "seo_impact",
    "geo_impact",
    "agentic_impact",
    "conversion_impact",
    "confidence",
    "effort",
    "validation"
  ],
  "properties": {
    "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
    "initiative": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "aeo_impact": {"$ref": "#/$defs/impact"},
    "seo_impact": {"$ref": "#/$defs/impact"},
    "geo_impact": {"$ref": "#/$defs/impact"},
    "agentic_impact": {"$ref": "#/$defs/impact"},
    "conversion_impact": {"$ref": "#/$defs/impact"},
    "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "effort": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "validation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "impact": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW", "NONE", "UNKNOWN"]
    }
  }
}
