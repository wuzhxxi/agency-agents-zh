{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-agents-zh.local/search-growth/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "agent",
    "evidence",
    "business_impact",
    "confidence",
    "effort",
    "affected_assets",
    "recommendation",
    "validation_method"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://agency-agents-zh.local/search-growth/evidence.schema.json"}
    },
    "business_impact": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]
    },
    "effort": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]
    },
    "affected_assets": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "recommendation": {"type": "string", "minLength": 1},
    "validation_method": {"type": "string", "minLength": 1}
  }
}
